{
  "name": "synartesis",
  "version": "0.3.2",
  "description": "An undo layer for AI agents.",
  "type": "module",
  "private": false,
  "author": "Arhaan (https://github.com/ArhaanDev24)",
  "license": "MIT",
  "homepage": "https://github.com/ArhaanDev24/Synartesis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArhaanDev24/Synartesis.git"
  },
  "bugs": {
    "url": "https://github.com/ArhaanDev24/Synartesis/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "undo",
    "rollback",
    "ai-agents",
    "saga"
  ],
  "bin": {
    "synartesis": "dist/cli.js",
    "synartesis-proxy": "dist/proxy.js"
  },
  "files": [
    "dist",
    "!dist/toy-crm.*",
    "!dist/demo-agent.*",
    "manifests",
    "!manifests/toy-crm.yaml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "tsup --silent",
    "demo": "tsup --silent && ./demo/filesystem-demo.sh",
    "demo:memory": "tsup --silent && ./demo/memory-demo.sh",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
